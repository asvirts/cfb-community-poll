{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"],
      "void/db": ["./.void/db.d.ts"],
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "vite.config.ts",
    "void.config.ts"
  ]
}
